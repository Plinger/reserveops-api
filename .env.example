NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:3100
LOG_LEVEL=info
# Optional for the current testnet preview. Set a real connection string when database features are enabled.
# MONGODB_URI=mongodb://127.0.0.1:27017/reserveops
STELLAR_NETWORK=testnet
# Set to 1 only when running behind a trusted single-hop reverse proxy such as Render.
TRUST_PROXY_HOPS=0
